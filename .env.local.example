# Copia este archivo a .env.local y rellena los valores.
# Estas variables NO se exponen al cliente; viven solo en el servidor.

ADMIN_EMAIL=tu-email@example.com
ADMIN_PASSWORD=tu-password-largo-y-aleatorio

# Token aleatorio largo usado para firmar la cookie de sesión admin.
# Genera uno con:  openssl rand -hex 32
ADMIN_SESSION_TOKEN=cambia-esto-por-un-token-aleatorio-de-64-chars
